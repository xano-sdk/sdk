{
  "name": "@xano/sdk",
  "version": "1.0.12",
  "description": "The official TypeScript SDK for Xano, one platform to build, run and govern AI-built software. Your coding agent writes the backend in TypeScript, you run it on the Xano Engine on your machine, then deploy it to Xano.",
  "keywords": [
    "xanosdk",
    "xano",
    "sdk",
    "typescript",
    "deploy",
    "ephemeral",
    "preview-environments",
    "infrastructure-as-code"
  ],
  "homepage": "https://github.com/xano-sdk/sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xano-sdk/sdk.git"
  },
  "bugs": {
    "url": "https://github.com/xano-sdk/sdk/issues"
  },
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "xanosdk": "dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "typesVersions": {
    "*": {
      "lambda-globals": [
        "types/lambda-globals.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    },
    "./scaffold": {
      "types": "./dist/scaffold.d.ts",
      "import": "./dist/scaffold.js"
    },
    "./codegen": {
      "types": "./dist/codegen.d.ts",
      "import": "./dist/codegen.js"
    },
    "./internal": {
      "types": "./dist/internal.d.ts",
      "import": "./dist/internal.js"
    },
    "./bundle": {
      "types": "./dist/bundle.d.ts",
      "import": "./dist/bundle.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js"
    },
    "./sveltekit": {
      "types": "./dist/sveltekit.d.ts",
      "import": "./dist/sveltekit.js"
    },
    "./lambda-globals": {
      "types": "./types/lambda-globals.d.ts"
    },
    "./package.json": "./package.json",
    "./manifest.json": "./manifest.json"
  },
  "files": [
    "dist",
    "types",
    "!dist/**/*.map",
    "manifest.json",
    "llms.txt",
    "llms-full.txt",
    "llms",
    "guides",
    "skills",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "openid-client": "^6.8.4",
    "proper-lockfile": "^4.1.2"
  },
  "peerDependencies": {
    "esbuild": ">=0.21.0"
  },
  "peerDependenciesMeta": {
    "esbuild": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^20.0.0",
    "@types/proper-lockfile": "^4.1.4",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^9.0.0",
    "gpt-tokenizer": "^3.4.0",
    "tsup": "^8.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.5.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
